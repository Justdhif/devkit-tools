# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example.pooler.aws.neon.tech/neondb?sslmode=require"

# API Server Port & URL
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# JWT Secret for DevKit session tokens
JWT_SECRET="devkit_super_secret_jwt_key_example"

# OAuth Configuration (GitHub & Google)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_GITHUB_CLIENT_ID=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional Redis Cache
REDIS_URL="redis://localhost:6379"

# AI Provider Key
GROQ_API_KEY=""
